# Copy to .env.local (never commit it). `node scripts/setup-solana.mjs` fills these in for devnet.
# The game runs without any of them: Solana features and the shared leaderboard simply switch off.

# Optional. Defaults to devnet.
SOLANA_RPC=https://api.devnet.solana.com

# Server only: TENGE mint authority + Toi Estelygi collection authority.
# Base58 secret key, or a JSON byte array like the one in .secrets/authority.json.
TOI_AUTHORITY_SECRET=

# TENGE (Token-2022) mint address. The VITE_ copy is what the browser sees.
TENGE_MINT=
VITE_TENGE_MINT=

# Toi Estelygi Metaplex Core collection address.
ESTELYGI_COLLECTION=
VITE_ESTELYGI_COLLECTION=

# Optional: Upstash Redis REST (shared leaderboard + claim/mint rate limits).
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN work too.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: API host for builds served elsewhere (the iDos Games build uses https://toi-bastar-six.vercel.app).
VITE_API_BASE=
